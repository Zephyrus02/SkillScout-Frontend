# SkillScout Frontend Environment Variables
# Copy this file to .env.local and fill in the values

# REST API origin used by frontend/lib/api/client.ts (interviews, etc.). Must match your backend PORT.
# Default in code is http://localhost:3001 if unset — align with backend (often 5001).
NEXT_PUBLIC_API_URL=http://localhost:5001

# Legacy: some auth/forms still read NEXT_PUBLIC_API_BASE_URL; keep in sync with NEXT_PUBLIC_API_URL when both are set.
NEXT_PUBLIC_API_BASE_URL=http://localhost:5001

# Abort hung API calls after this many ms (prelaunch "Starting…" no longer waits forever). Default 45000.
# NEXT_PUBLIC_API_FETCH_TIMEOUT_MS=45000

# LiveKit-backed interview session (POST /api/interviews, token, voice agent room). Default off = static room UI only.
# NEXT_PUBLIC_ENABLE_LIVEKIT_INTERVIEW=true

# Google OAuth Client ID (from Google Cloud Console)
# Used for Google Sign-In button
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Application environment (development | production)
NEXT_PUBLIC_APP_ENV=development

# Agentation MCP server endpoint (dev-only toolbar sync)
NEXT_PUBLIC_AGENTATION_ENDPOINT=http://localhost:4747

# Agentation MCP server endpoint (dev-only toolbar sync)
NEXT_PUBLIC_AGENTATION_ENDPOINT=http://localhost:4747
